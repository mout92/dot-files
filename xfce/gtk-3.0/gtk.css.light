.xfce4-panel {
    border-top: 1px solid rgba(0,0,0,0.6);
    border-bottom: 1px solid rgba(0,0,0,0.6);
    box-shadow: inset 0px 1px white;
}

.xfce4-panel .tasklist button {
  padding-left: 4px;
  margin-left: 4px;
  border: 1px solid rgba(125,125,125,0.55);
  border-radius: 4px;
  background-image: linear-gradient(
    to bottom,
    rgba(255,255,255,0.60),
    rgba(255,255,255,0.40)
  );
}

.xfce4-panel .tasklist button:checked {
  border: 1px solid #7d7d7d;
  background-image: linear-gradient(
    to top,
    rgba(0,0,0,0.20),
    rgba(0,0,0,0.10)
  );
}

#XfcePanelWindowWrapper {
    border: none;
    box-shadow: none;
}

#applicationmenu-button {
  padding-left: 8px;
  padding-right: 8px;
  border: 1px solid rgba(125,125,125,0.55);
  border-radius: 4px;
}
